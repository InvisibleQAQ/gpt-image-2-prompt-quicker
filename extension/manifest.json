{
    "manifest_version": 3,
    "name": "chatgpt image prompt quicker",
    "version": "1.6.0",
    "description": "Quickly access all the image prompts you need.",
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "permissions": [
        "storage",
        "contextMenus"
    ],
    "host_permissions": [
        "https://raw.githubusercontent.com/*",
        "https://cdn.jsdelivr.net/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "lib/dom.js",
                "lib/utils.js",
                "lib/i18n.js",
                "lib/prompt_utils.js",
                "lib/store.js",
                "services/fetcher.js",
                "services/config.js",
                "services/prompts.js",
                "sites/base.js",
                "sites/chatgpt.js",
                "sites/dynamic.js",
                "ui/search.js",
                "ui/card.js",
                "ui/announcement.js",
                "ui/prompt_form.js",
                "ui/pagination.js",
                "ui/modal.js",
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "icon16.png",
                "icon48.png",
                "icon128.png"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "banana-prompt-quicker@glidea.io",
            "strict_min_version": "109.0"
        }
    }
}
